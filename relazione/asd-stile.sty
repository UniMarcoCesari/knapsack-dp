% ============================================================
%  PSEUDOCODICE in stile CLRS / Zanella
%  Uso:
%   \begin{pseudocodice}{NOME-PROC$(A)$}
%     \riga{1}{0}{\kw{for} $j \gets 2$ \kw{to} $\length[A]$}
%     \riga{2}{1}{\kw{do} $key \gets A[j]$}
%     \rigacomm{3}{2}{si inserisce $A[j]$ \dots}
%   \end{pseudocodice}
% ============================================================
\newcommand{\kw}[1]{\textbf{#1}}                       % parole chiave
\newcommand{\length}{\mathit{length}}
\newcommand{\proc}[1]{\textsc{#1}}                     % nome procedura
\newlength{\indentunit}\setlength{\indentunit}{1.6em}
\newcommand{\indlev}[1]{\hspace*{\dimexpr#1\indentunit\relax}}

\newenvironment{pseudocodice}[1]{%
  \par\smallskip
  \begin{tcolorbox}[enhanced,breakable,colback=black!2,colframe=asdblu!55,
    boxrule=0.5pt,arc=2pt,left=6pt,right=6pt,top=5pt,bottom=5pt,
    fontupper=\normalsize]
  \noindent{\sffamily\bfseries\proc{#1}}\par\vspace{2pt}
  \setlength{\tabcolsep}{0.6em}\small
  \begin{tabular}{@{}r@{\hspace{0.9em}}l@{}}}
{\end{tabular}\end{tcolorbox}\par\smallskip}
% riga: numero, livello indentazione, contenuto
\newcommand{\riga}[3]{\textcolor{asdgrigio}{\scriptsize #1} & \indlev{#2}#3 \\}
% riga di commento (in stile prof: triangolo)
\newcommand{\rigacomm}[3]{\textcolor{asdgrigio}{\scriptsize #1} & \indlev{#2}\textcolor{asdgrigio}{$\triangleright$ \textit{#3}} \\}
% riga senza numero (continuazione)
\newcommand{\rigac}[2]{ & \indlev{#1}#2 \\}

% ---- Frontespizio capitolo ---------------------------------
\newcommand{\frontespizio}[3]{% #1=numero cap, #2=titolo, #3=sottotitolo/files
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[asdblu] (current page.north west) rectangle ([yshift=-3.2cm]current page.north east);
    \node[anchor=west,text=white,font=\sffamily\bfseries\Huge]
      at ([xshift=2.6cm,yshift=-1.55cm]current page.north west) {Capitolo #1};
    \node[anchor=west,text=asdblusoft,font=\sffamily\large]
      at ([xshift=2.6cm,yshift=-2.5cm]current page.north west)
      {Algoritmi e Strutture Dati — Prof.ssa M.~Zanella};
    % Titolo del capitolo, ben sotto la banda
    \node[anchor=north west,text=asdblu,align=left,
      text width=15.8cm,font=\sffamily\bfseries\fontsize{27}{31}\selectfont]
      at ([xshift=2.6cm,yshift=-5.0cm]current page.north west) {#2};
  \end{tikzpicture}
  \vspace*{8.6cm}\par
  {\color{asdgrigio}\large #3\par}
  \vspace{0.3cm}
  {\color{asdgrigio}\footnotesize Dispensa di studio basata sui lucidi del corso — \today\par}
  \vspace{0.7cm}\hrule height 0.6pt
  \vspace{1.0cm}
}

