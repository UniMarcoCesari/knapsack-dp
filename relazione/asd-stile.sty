% ============================================================
\newcounter{asdbox}[section]
\renewcommand{\theasdbox}{\thesection.\arabic{asdbox}}

\newtcolorbox{definizione}[1][]{%
  breakable,enhanced,colback=asdblusoft,colframe=asdblu,
  boxrule=0.4pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\color{white},
  coltitle=white,attach boxed title to top left={xshift=8pt,yshift=-2pt},
  boxed title style={colback=asdblu,boxrule=0pt,arc=2pt},
  title={Definizione\ifx\relax#1\relax\else\ — #1\fi}}

\newtcolorbox{teorema}[1][]{%
  breakable,enhanced,colback=asdverdesoft,colframe=asdverde,
  boxrule=0.4pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\color{white},
  coltitle=white,attach boxed title to top left={xshift=8pt,yshift=-2pt},
  boxed title style={colback=asdverde,boxrule=0pt,arc=2pt},
  title={Teorema\ifx\relax#1\relax\else\ — #1\fi}}

\newtcolorbox{nota}[1][Nota]{%
  breakable,enhanced,colback=asdorosoft,colframe=asdoro,
  boxrule=0.4pt,arc=2pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\color{asdoro!60!black},
  detach title,before upper={\tcbtitle\par\smallskip},
  title={#1}}

\newtcolorbox{esempio}[1][]{%
  breakable,enhanced,colback=asdgrigiosoft,colframe=asdgrigio!60,
  boxrule=0.4pt,arc=2pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  fonttitle=\sffamily\bfseries\color{asdgrigio},
  detach title,before upper={\tcbtitle\par\smallskip},
  title={Esempio\ifx\relax#1\relax\else\ — #1\fi}}

